# Copy this file to .env.local and fill in both values.
# .env.local is git-ignored, so your keys never get committed.
#
# Where to find them: Supabase dashboard → your project → "Connect" button
# (top of the page), or Project Settings → API Keys.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). The legacy "anon public"
# key (a long eyJ... token) also works.
# NEVER put the secret / service_role key here: it ends up in the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=
